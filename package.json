{
  "name": "empreeteira-pedro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "test": "vitest run --exclude tests/seed.test.ts --exclude tests/seed-usuarios.test.ts",
    "test:seed": "npx supabase db reset && vitest run tests/seed.test.ts tests/seed-usuarios.test.ts",
    "test:all": "npm run test && npm run test:seed",
    "test:watch": "vitest",
    "db:reset": "npx supabase db reset",
    "e2e": "playwright test"
  },

  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
